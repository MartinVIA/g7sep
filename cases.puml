@startuml cases
    VillagerList -->"0..*" Villager 
    Points --|> "0..*" Villager 
      

class Villager{
    - ID : int
    - Name : String
    - personalPoints : int

}

class VillagerList{
    + points : int
    + attribute5 : int
}

class Points{
    - attrubute6 : int

    + setPoints() : void
    + operation() : void
    + awardPoints() : void

}

